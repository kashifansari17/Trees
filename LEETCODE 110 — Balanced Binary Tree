/***************************************************************************************************
* 🔥 LEETCODE 110 — Balanced Binary Tree (Optimized O(N) Solution)
* -----------------------------------------------------------------------------------------------
* 🧩 PROBLEM:
* Determine whether a binary tree is height-balanced.
* A binary tree is balanced if, for every node, the absolute difference between
* the heights of its left and right subtrees is at most 1.
*
* Example:
* Input:  root = [3,9,20,null,null,15,7]
* Output: true
*
* -----------------------------------------------------------------------------------------------
* 💡 INTUITION (Optimized Approach):
* The brute force method recalculates heights for every node (O(N²)).
* To optimize:
* - Perform a **postorder DFS traversal**.
* - For each node:
*     → Recursively compute left & right subtree heights.
*     → If any subtree is unbalanced (returns -1), propagate -1 upward.
*     → If |left - right| > 1 → return -1 (unbalanced).
* - Else return the node’s height = max(left, right) + 1.
*
* This way, each node is visited only once → O(N).
***************************************************************************************************/


/***************************************************************************************************
* 🧮 ALGORITHM (Step-by-Step)
* -----------------------------------------------------------------------------------------------
* Step 1: If the root is NULL, the tree is balanced (return true).
* Step 2: Create a helper function `dfsHeight(node)` that:
*         1️⃣ Returns 0 if node == NULL (base case).
*         2️⃣ Recursively computes leftHeight = dfsHeight(node->left).
*             - If leftHeight == -1 → left subtree unbalanced → return -1.
*         3️⃣ Recursively computes rightHeight = dfsHeight(node->right).
*             - If rightHeight == -1 → right subtree unbalanced → return -1.
*         4️⃣ If abs(leftHeight - rightHeight) > 1 → current node unbalanced → return -1.
*         5️⃣ Otherwise, return max(leftHeight, rightHeight) + 1.
* Step 3: In `isBalanced()`, call dfsHeight(root).
* Step 4: If dfsHeight(root) == -1 → return false (unbalanced).
*         Else → return true (balanced).
***************************************************************************************************/


// ✅ OPTIMIZED CODE — O(N) TIME COMPLEXITY
class Solution {
public:
    // Main function: returns true if the tree is balanced
    bool isBalanced(TreeNode* root) {
        return dfsHeight(root) != -1;
    }

private:
    // Helper function: returns height if balanced, else returns -1
    int dfsHeight(TreeNode* root) {
        if (root == NULL) return 0; // Base case: empty tree has height 0

        // Recursively check left subtree
        int leftHeight = dfsHeight(root->left);
        if (leftHeight == -1) return -1; // Unbalanced left subtree

        // Recursively check right subtree
        int rightHeight = dfsHeight(root->right);
        if (rightHeight == -1) return -1; // Unbalanced right subtree

        // If difference in height > 1 → not balanced
        if (abs(leftHeight - rightHeight) > 1) return -1;

        // Return height of current node
        return max(leftHeight, rightHeight) + 1;
    }
};



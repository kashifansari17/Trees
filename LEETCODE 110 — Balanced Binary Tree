/***************************************************************************************************
* 🔥 LEETCODE 110 — Balanced Binary Tree
* -----------------------------------------------------------------------------------------------
* 🧩 PROBLEM:
* Given a binary tree, determine if it is height-balanced.
* A height-balanced binary tree is defined as:
* For every node, the absolute difference between the heights of the left and right subtrees ≤ 1.
*
* Example:
* Input: root = [3,9,20,null,null,15,7]
* Output: true
*
* -----------------------------------------------------------------------------------------------
* 💡 INTUITION (Brute Force Approach):
* - For each node:
*     → Compute height of left subtree.
*     → Compute height of right subtree.
*     → If |lh - rh| > 1 → tree is unbalanced.
* - Recursively check left and right subtrees for balance.
*
* This approach recalculates heights multiple times — hence O(N²).
***************************************************************************************************/

// ✅ BRUTE FORCE SOLUTION
class Solution {
public:
    // Helper function: returns height of a given subtree
    int height(TreeNode* node) {
        if (node == NULL) return 0;
        return 1 + max(height(node->left), height(node->right));
    }

    // Main function: checks if the binary tree is balanced
    bool isBalanced(TreeNode* root) {
        if (root == NULL) return true; // base case: empty tree is balanced

        int lh = height(root->left);   // height of left subtree
        int rh = height(root->right);  // height of right subtree

        // If difference exceeds 1 → not balanced
        if (abs(lh - rh) > 1) return false;

        // Check recursively for left and right subtrees
        return isBalanced(root->left) && isBalanced(root->right);
    }
};

